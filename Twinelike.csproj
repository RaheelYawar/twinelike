<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <OutputType>Library</OutputType>
        <TargetFramework>netstandard2.0</TargetFramework>
        <RootNamespace>Harlowe</RootNamespace>
        <!-- Lower-case on purpose: the output is twinelike.dll. A mixed-case
             filename trips case-sensitive filesystems (Linux CI runners, IL2CPP
             pipelines) when paths are referenced literally. The NuGet PackageId
             stays PascalCase "Twinelike"; package ids are case-insensitive. -->
        <AssemblyName>twinelike</AssemblyName>
        <DefaultItemExcludes>$(DefaultItemExcludes);HarloweParser.Tests\**</DefaultItemExcludes>
        <LangVersion>latest</LangVersion>
        <!-- Required for ILRepack: copies transitive deps (HtmlAgilityPack)
             into the output folder so the merge target can find them. -->
        <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
    </PropertyGroup>

    <!-- NuGet package metadata. Run `dotnet pack -c Release` to produce a .nupkg. -->
    <PropertyGroup>
        <PackageId>Twinelike</PackageId>
        <Version>0.2.0</Version>
        <Authors>Raheel Yawar</Authors>
        <Company>Raheel Yawar</Company>
        <Description>A C# library for parsing and running Twine/Harlowe interactive fiction stories. Targets game engines (Unity, Godot, etc.) via an engine-agnostic IRenderOutput interface. Accepts Twine 2 HTML exports and Twee 3 source; emits Twee 3.</Description>
        <PackageTags>twine;harlowe;interactive-fiction;narrative;unity;godot;game-engine;parser</PackageTags>
        <PackageLicenseExpression>MIT</PackageLicenseExpression>
        <PackageProjectUrl>https://github.com/RaheelYawar/twinelike</PackageProjectUrl>
        <RepositoryUrl>https://github.com/RaheelYawar/twinelike</RepositoryUrl>
        <RepositoryType>git</RepositoryType>
        <PackageReadmeFile>README.md</PackageReadmeFile>
        <!-- No symbol package. ILRepack rewrites twinelike.dll during the merge,
             so the compiler-emitted PDB no longer matches the shipped DLL's debug
             signature; nuget.org rejects the resulting .snupkg ("pdb for a dll not
             found in the package"). Local Release builds still produce a PDB for
             debugging — it's just not packed or published. -->
        <IncludeSymbols>false</IncludeSymbols>
    </PropertyGroup>

    <ItemGroup>
        <None Include="README.md" Pack="true" PackagePath="\" />
        <!-- HtmlAgilityPack (MIT) is ILRepack-merged into twinelike.dll, so its
             licence + copyright notice must travel with the package. -->
        <None Include="THIRD-PARTY-NOTICES.txt" Pack="true" PackagePath="\" />
    </ItemGroup>

    <ItemGroup>
        <!-- HtmlAgilityPack is consumed by Layer 1 (the Twine 2 HTML loader)
             and merged into twinelike.dll at build time by the ILRepack target
             below. PrivateAssets=all keeps it out of the produced NuGet
             package's dependency list so consumers see a single self-contained
             DLL with zero external deps. -->
        <PackageReference Include="HtmlAgilityPack" Version="1.13.0">
            <PrivateAssets>all</PrivateAssets>
        </PackageReference>

        <!-- Build-time only: drives the ILRepack target below. PrivateAssets=all
             keeps it out of the nuspec. -->
        <PackageReference Include="ILRepack.Lib.MSBuild.Task" Version="2.0.46">
            <PrivateAssets>all</PrivateAssets>
        </PackageReference>
    </ItemGroup>

    <!-- ILRepack merge logic lives in ./ILRepack.targets — the package's own
         override mechanism (its default target is skipped when that file
         exists). That file merges HtmlAgilityPack into twinelike.dll on
         Release builds with HAP types internalized so they don't pollute
         the public API or conflict with a consumer's own HAP reference. -->
</Project>
