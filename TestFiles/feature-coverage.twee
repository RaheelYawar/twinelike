(set: $x to 5)(print: $x)

:: Interpolation
(set: $name to "Bob")Hello $name!

:: Arithmetic
(print: 2 + 3 * 4)

:: StringConcat
(print: "a" + "b" + "c")

:: BooleanLogic
(print: true and false or true)

:: IfElse
(set: $n to 7)(if: $n > 5)[big](else:)[small]

:: ElseIf
(set: $n to 2)(if: $n is 1)[one](else-if: $n is 2)[two](else:)[other]

:: Unless
(unless: false)[shown]

:: NamedHook
|h>[hooked content]

:: AnonymousHook
pre [middle] post

:: Link
[[Go to prose->Prose]]

:: Array
(set: $a to (a: 10, 20, 30))(print: $a's 2nd)

:: ArrayLength
(print: (a: 1, 2, 3)'s length)

:: Datamap
(set: $d to (dm: "hp", 10))(print: $d's hp)

:: ForLoop
(for: each _i, 1, 2, 3)[_i ]

:: FindLambda
(print: (find: _x where _x > 2, 1, 2, 3, 4))

:: AlteredLambda
(print: (altered: _x via _x * 2, 1, 2, 3))

:: FoldedLambda
(print: (folded: _n making _t via _t + _n, 1, 2, 3, 4))

