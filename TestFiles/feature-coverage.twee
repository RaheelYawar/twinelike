(text-size: 2)[big text]

:: ReplaceHook
|t>[original](replace: ?t)[replaced]

:: AppendHook
|ap>[start](append: ?ap)[ end]

:: EnchantHook
|e>[enchanted text](enchant: ?e, (text-style: "bold"))

:: EnchantLink
(enchant: ?link, (text-style: "bold"))[[Go->Prose]]

:: ChangeHook
|ch>[changed text](change: ?ch, (text-style: "italic"))

:: ClickHook
|c>[click me](click: ?c)[revealed]

